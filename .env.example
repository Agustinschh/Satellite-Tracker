# Configuración opcional de credenciales para TP7 Satellite Tracker
# Las credenciales también pueden ingresarse desde la pestaña Validación/Ajustes en la app (guardadas en SecureStore)
# o configurarse en el servidor proxy opcional (proxy/server.js).

EXPO_PUBLIC_PROXY_URL=http://localhost:4000

# Solo para el servidor proxy Node.js (nunca incluir secretos reales en el repositorio Git):
N2YO_API_KEY=tu_api_key_de_n2yo
SPACETRACK_IDENTITY=tu_email_spacetrack
SPACETRACK_PASSWORD=tu_password_spacetrack
PORT=4000

